---
// Shared page layout: header with navigation, the "data as of" strip, footer. Part of the design
// system that moves to martinogie/portfolio-site (pinned copy here; site/PLAN.md, section 2).
import "@fontsource-variable/inter";
import "@fontsource-variable/newsreader";
import "./tokens.css";
import "./base.css";

interface Props {
  title: string;
  description: string;
  current: "overview" | "watchlist" | "bank" | "methods" | "pipeline";
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  ["overview", "Overview", `${base}/`],
  ["watchlist", "Watchlist", `${base}/watchlist/`],
  ["bank", "Bank detail", `${base}/bank/`],
  ["methods", "Model & methods", `${base}/methods/`],
  ["pipeline", "Pipeline", `${base}/pipeline/`],
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Bank Health</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body data-base={base}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${base}/`}>
          <span class="brand-name">Bank Health</span>
          <span class="brand-tag">US bank early warning</span>
        </a>
        <nav aria-label="Main" class="nav">
          {nav.map(([key, label, href]) => (
            <a href={href} aria-current={current === key ? "page" : undefined}>{label}</a>
          ))}
        </nav>
      </div>
      <div class="strip">
        <div class="wrap strip-row small">
          <!-- Placeholders as long as the real text, so nothing moves when the data arrives. -->
          <span data-asof aria-busy="true">Data as of ––––––– · updated ––– ––, ––––</span>
          <span data-model>Model v–</span>
          <span>Refreshed weekly from FDIC call reports</span>
          <span data-preview class="preview" style="visibility:hidden" aria-hidden="true">Preview data</span>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="stack" style="gap:10px">
          <span class="serif" style="font-size:24px;color:var(--bg)">Bank Health</span>
          <p style="color:var(--footer-text-2)">A screening tool built on public data. A model estimate from public FDIC data, not a supervisory rating; it should not be used to judge any bank on its own.</p>
        </div>
        <div class="stack" style="gap:8px">
          <span class="foot-label">Sources</span>
          <span>FDIC BankFind Suite (call reports, institutions, failures)</span>
          <span>CFPB Consumer Complaint Database</span>
        </div>
        <div class="stack" style="gap:8px">
          <span class="foot-label">Built by</span>
          <span>Martins Ogiekpolor</span>
          <a href="https://github.com/martinogie/bank-health-data-platform">Code on GitHub</a>
          <a href={`${base}/pipeline/`}>How the pipeline works</a>
          <span style="color:var(--footer-text-2)">Built with AI-assisted coding; the design, analysis and review are my own.</span>
        </div>
      </div>
      <div class="wrap small" style="padding-bottom:28px;color:var(--muted-dark)">No tracking, no cookies.</div>
    </footer>
    <script>
      import { loadJson, quarterText } from "../lib/site";
      // Fill the "data as of" strip from the overview file (every page).
      loadJson("overview.json")
        .then((o) => {
          const asof = document.querySelector("[data-asof]");
          if (asof) { asof.textContent = quarterText(o); asof.removeAttribute("aria-busy"); }
          const model = document.querySelector("[data-model]");
          if (model) model.textContent = `Model v${o.modelVersion}`;
          const preview = document.querySelector<HTMLElement>("[data-preview]");
          if (preview && o.fixture) { preview.style.visibility = "visible"; preview.removeAttribute("aria-hidden"); }
          else preview?.remove();
        })
        .catch(() => {
          const asof = document.querySelector("[data-asof]");
          if (asof) { asof.textContent = "Data unavailable"; asof.removeAttribute("aria-busy"); }
        });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -9999px; top: 0; background: var(--ink); color: var(--bg); padding: 8px 12px; }
  .skip:focus { left: 8px; top: 8px; z-index: 10; }
  .site-header { border-bottom: 1px solid var(--ink); background: var(--bg); }
  .header-row { padding-top: 18px; padding-bottom: 18px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { text-decoration: none; color: var(--ink); display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .brand-name { font-family: var(--serif); font-size: 28px; font-weight: 600; letter-spacing: -0.01em; }
  .brand-tag { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .nav { display: flex; flex-wrap: wrap; gap: 4px; }
  .nav a { padding: 10px 14px; font-size: 14px; color: var(--ink); text-decoration: none; border-bottom: 2px solid transparent; }
  .nav a[aria-current="page"] { font-weight: 600; border-bottom-color: var(--accent); }
  /* At least a screen tall, so the footer starts below the fold and can't jump while data loads. */
  main { min-height: 100vh; }
  .strip { border-top: 1px solid var(--rule); }
  .strip-row { padding-top: 8px; padding-bottom: 8px; display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--ink-3); }
  .preview { color: var(--accent); font-weight: 600; border: 1px solid var(--accent); padding: 0 8px; }
  .site-footer { background: var(--ink); color: var(--footer-text); margin-top: 24px; }
  .site-footer a { color: var(--bg); }
  .footer-grid { padding-top: 48px; padding-bottom: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 32px; font-size: 14px; }
  .foot-label { font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted-dark); }
  @media (max-width: 640px) { .nav a { padding: 10px 8px; } }
</style>
