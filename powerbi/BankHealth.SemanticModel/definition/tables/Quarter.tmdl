table Quarter
	lineageTag: 32baa62c-979c-518a-be61-3533ac160e62

	column 'Quarter End'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: e84cf2b8-24d5-556b-9854-390e453e6877
		summarizeBy: none
		sourceColumn: [Quarter End]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 62a0a085-edae-5a68-a6bb-533362183813
		summarizeBy: none
		sourceColumn: [Year]

	column 'Quarter Label'
		dataType: string
		lineageTag: 0bed514b-f28c-5ba5-9244-723faad39038
		summarizeBy: none
		sourceColumn: [Quarter Label]
		sortByColumn: 'Quarter End'

	column n
		dataType: int64
		isHidden
		lineageTag: d1c6ae58-5a0b-5071-b4a1-8a902ebb5168
		summarizeBy: none
		sourceColumn: [n]

	partition Quarter = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    SELECTCOLUMNS ( GENERATESERIES ( 1, 108, 1 ), "n", [Value] ),
				    "Quarter End", EOMONTH ( DATE ( 2000, 1, 1 ), [n] * 3 - 1 ),
				    "Year", YEAR ( EOMONTH ( DATE ( 2000, 1, 1 ), [n] * 3 - 1 ) ),
				    "Quarter Label",
				        YEAR ( EOMONTH ( DATE ( 2000, 1, 1 ), [n] * 3 - 1 ) ) & " Q"
				            & ROUNDUP ( MONTH ( EOMONTH ( DATE ( 2000, 1, 1 ), [n] * 3 - 1 ) ) / 3, 0 )
				)

	annotation PBI_Id = f8cff7bb0e3b4793a0cbc67527e80dd4
