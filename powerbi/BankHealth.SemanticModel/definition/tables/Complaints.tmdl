	partition Complaints = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "BANK_WH", [Role = "BANK_REPORTER_ROLE", Implementation = "2.0"]),
				    BANK_HEALTH_Database = Source{[Name = "BANK_HEALTH", Kind = "Database"]}[Data],
				    MARTS_Schema = BANK_HEALTH_Database{[Name = "MARTS", Kind = "Schema"]}[Data],
				    Data = MARTS_Schema{[Name = "FCT_COMPLAINTS", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CERT", "DATE_RECEIVED", "QUARTER_END_DATE", "COMPANY", "IS_MATCHED_BANK", "PRODUCT", "ISSUE", "COMPANY_RESPONSE", "IS_MONETARY_RELIEF", "TIMELY_RESPONSE", "SUBMITTED_VIA", "STATE_CODE"})
				in
				    Kept

	annotation PBI_ResultType = Table

