table Complaints
	lineageTag: b782b917-2959-4705-950c-5b02c5d4e4bc

	measure 'Complaint Count' = COUNTROWS ( Complaints )
		formatString: #,0
		lineageTag: a531d136-8a34-4abc-a5c2-346e4447edf0

	measure 'Monetary Relief %' = DIVIDE ( CALCULATE ( [Complaint Count], Complaints[IS_MONETARY_RELIEF] = TRUE () ), [Complaint Count] )
		formatString: 0.0%
		lineageTag: 681ed15c-e91a-461e-ae22-7e9a9ff1b473

