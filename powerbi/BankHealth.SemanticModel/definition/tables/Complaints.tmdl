table Complaints
	lineageTag: 0c929153-c412-5a3c-be21-99df4dbe40ac

	measure 'Complaint Count' = COUNTROWS ( Complaints )
		formatString: #,0
		lineageTag: c58cbe2d-93a3-5e1a-9a32-390d75f449c7

	measure 'Monetary Relief %' = DIVIDE ( CALCULATE ( [Complaint Count], Complaints[IS_MONETARY_RELIEF] = TRUE () ), [Complaint Count] )
		formatString: 0.0%
		lineageTag: b040e988-26cb-5ce5-a158-2b2d4d4a1834

	column CERT
		dataType: int64
		formatString: 0
