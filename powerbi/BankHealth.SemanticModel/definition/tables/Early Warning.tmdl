table 'Early Warning'
	lineageTag: e1431efe-c1e7-5e01-871a-514663d7bca4

	measure 'Banks In Band' = COUNTROWS ( 'Early Warning' )
		formatString: #,0
		lineageTag: 7f08322d-6f0c-5cad-8e26-0c603aa3251c

	measure 'Banks Scored' = CALCULATE ( COUNTROWS ( 'Early Warning' ), NOT 'Early Warning'[RISK_BAND] IN { "New bank – not scored", "Office of a foreign bank – not scored" } )
		formatString: #,0
		lineageTag: edb558ec-36b8-5167-a146-e3c68a81bde7

	measure 'Banks Not Scored' = CALCULATE ( COUNTROWS ( 'Early Warning' ), 'Early Warning'[RISK_BAND] IN { "New bank – not scored", "Office of a foreign bank – not scored" } )
		formatString: #,0
		lineageTag: 864b8d64-87de-5d34-9085-962e33cf1137

	measure 'Banks High Risk' = CALCULATE ( [Banks Scored], 'Early Warning'[RISK_BAND] = "High" )
		formatString: #,0
		lineageTag: c69149bd-6c15-5967-9ac8-a2e692e63a00

	measure 'Banks Elevated Risk' = CALCULATE ( [Banks Scored], 'Early Warning'[RISK_BAND] = "Elevated" )
		formatString: #,0
		lineageTag: 912da14c-61be-51e3-85cf-5f3d9fc440ce

	measure 'Banks Watch' = CALCULATE ( [Banks Scored], 'Early Warning'[RISK_BAND] = "Watch" )
		formatString: #,0
		lineageTag: ea0fbe82-99db-5f37-87df-b9d1c5fc1860

	measure 'Banks Already in Distress' = CALCULATE ( [Banks Scored], 'Early Warning'[RISK_BAND] = "Already in distress" )
		formatString: #,0
		lineageTag: 180eca80-23fa-5d74-8314-d11a1c16389d

	measure 'Assets High + Elevated $B' =
			DIVIDE (
			    CALCULATE ( SUM ( 'Early Warning'[TOTAL_ASSETS_K] ), 'Early Warning'[RISK_BAND] IN { "High", "Elevated" } ),
			    1e6
			)
		formatString: \$#,0B
		lineageTag: 14ebc9f3-5ee1-5c53-841d-de79c32b7fcb

	measure 'Avg Distress Probability' = AVERAGE ( 'Early Warning'[DISTRESS_PROBABILITY] )
		formatString: 0.0%
		lineageTag: 51ebc327-80af-5840-9ae9-d6ccf8cc7130

	measure 'Avg Complaints per $1B' = AVERAGE ( 'Early Warning'[COMPLAINTS_PER_1B_DEPOSITS] )
		formatString: 0.0
		lineageTag: 8b0ca9b3-de00-5324-abf4-331f21515d14

	measure 'Scores As Of' = "Scores as of " & FORMAT ( MAX ( 'Early Warning'[REPORT_DATE] ), "d mmm yyyy" ) & " · model v" & MAX ( 'Early Warning'[MODEL_VERSION] ) & " · " & FORMAT ( [Banks Scored], "#,0" ) & " banks scored"
		lineageTag: d40e0898-a058-5dac-8fb2-35786fa6f570

	measure 'Bank Risk Band' = "Risk band: " & SELECTEDVALUE ( 'Early Warning'[RISK_BAND], "Not scored" )
		lineageTag: 8ce26d82-a294-5016-95a4-301025c01dae

	measure 'Bank Distress Probability' = SELECTEDVALUE ( 'Early Warning'[DISTRESS_PROBABILITY] )
		formatString: 0.0%
		lineageTag: 293016a1-bc3f-552e-af9d-8cb952ce1eb5

	measure 'Main Reason' =
			VAR r = SELECTEDVALUE ( 'Early Warning'[REASON_1] )
			RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( r, "30_89", "30-89 days" ), "_pct", " %" ), "_", " " )
		lineageTag: c59dbdf3-b29c-577e-a329-63792a6716a5

	measure 'Second Reason' =
			VAR r = SELECTEDVALUE ( 'Early Warning'[REASON_2] )
			RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( r, "30_89", "30-89 days" ), "_pct", " %" ), "_", " " )
		lineageTag: b67f3a6f-2d8f-59e2-bfa1-abc56520bc44

	measure 'Third Reason' =
			VAR r = SELECTEDVALUE ( 'Early Warning'[REASON_3] )
			RETURN SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( r, "30_89", "30-89 days" ), "_pct", " %" ), "_", " " )
		lineageTag: deb18306-e4bf-55c8-b14c-160e37cc83bf

	measure 'Bank Reason 1' = "1. " & COALESCE ( [Main Reason], "—" )
		lineageTag: 3d2808e2-f31d-59fe-8684-d13c8aa7b103

	measure 'Bank Reason 2' = "2. " & COALESCE ( [Second Reason], "—" )
		lineageTag: d51c7db9-d12e-5a82-914d-f61b3052cb5a

	measure 'Bank Reason 3' = "3. " & COALESCE ( [Third Reason], "—" )
		lineageTag: 077e3638-ceb4-5ea0-8e13-c6dc90e4b7fc

