	column BAND_ORDER
		dataType: int64
		isHidden
		lineageTag: 5fa26ccb-e2b3-4f27-9db8-81eb903a4196
		summarizeBy: none
		sourceColumn: BAND_ORDER

	partition 'Early Warning' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "BANK_WH", [Role = "BANK_REPORTER_ROLE", Implementation = "2.0"]),
				    BANK_HEALTH_Database = Source{[Name = "BANK_HEALTH", Kind = "Database"]}[Data],
				    MARTS_Schema = BANK_HEALTH_Database{[Name = "MARTS", Kind = "Schema"]}[Data],
				    Data = MARTS_Schema{[Name = "MART_EARLY_WARNING", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CERT", "BANK_NAME", "CITY", "STATE_CODE", "REPORT_DATE", "ASSET_SIZE_TIER", "TOTAL_ASSETS_K", "DISTRESS_PROBABILITY", "RISK_PERCENTILE", "RISK_RANK", "RISK_BAND", "ALREADY_IN_DISTRESS", "REASON_1", "REASON_2", "REASON_3", "TIER1_LEVERAGE_PCT", "NONCURRENT_LOANS_PCT", "ROA_PCT", "COMPLAINTS", "COMPLAINTS_PER_1B_DEPOSITS", "MODEL_VERSION"}),
				    Ordered = Table.AddColumn(Kept, "BAND_ORDER", each if [RISK_BAND] = "High" then 1 else if [RISK_BAND] = "Elevated" then 2 else if [RISK_BAND] = "Watch" then 3 else if [RISK_BAND] = "Low" then 4 else 5, Int64.Type)
				in
				    Ordered

	annotation PBI_ResultType = Table

