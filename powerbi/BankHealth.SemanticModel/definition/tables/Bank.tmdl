	partition Bank = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "BANK_WH", [Role = "BANK_REPORTER_ROLE", Implementation = "2.0"]),
				    BANK_HEALTH_Database = Source{[Name = "BANK_HEALTH", Kind = "Database"]}[Data],
				    MARTS_Schema = BANK_HEALTH_Database{[Name = "MARTS", Kind = "Schema"]}[Data],
				    Data = MARTS_Schema{[Name = "DIM_BANK", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CERT", "BANK_NAME", "CITY", "STATE_CODE", "STATE_NAME", "BANK_CLASS", "PRIMARY_REGULATOR", "HOLDING_COMPANY", "IS_ACTIVE", "HAS_FAILED", "LATEST_TOTAL_ASSETS_K", "LATEST_ASSET_SIZE_TIER", "HAS_CFPB_COMPLAINTS"})
				in
