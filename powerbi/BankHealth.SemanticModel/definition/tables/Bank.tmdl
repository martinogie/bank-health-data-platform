table Bank
	lineageTag: 5bc85db3-3645-4d55-b900-09296f10562a

	measure 'Selected Bank' =
			VAR b = SELECTEDVALUE ( Bank[BANK_NAME] )
			RETURN IF ( ISBLANK ( b ), "Right-click a bank on Early warning → Drill through → Bank detail",
			    b & " · " & SELECTEDVALUE ( Bank[CITY] ) & ", " & SELECTEDVALUE ( Bank[STATE_CODE] ) & " · CERT " & SELECTEDVALUE ( Bank[CERT] ) )
		lineageTag: f03ef93f-edb1-4225-8c42-138d0785b1c0

	measure 'Bank Holding Company' =
			VAR h = SELECTEDVALUE ( Bank[HOLDING_COMPANY] )
			RETURN IF ( ISBLANK ( h ), "No holding company on file", "Holding company: " & h )
		lineageTag: c0138366-c438-4a53-8131-6fa9f68c66ae

