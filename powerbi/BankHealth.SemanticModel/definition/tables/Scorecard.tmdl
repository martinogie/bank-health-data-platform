	partition Scorecard = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, "BANK_WH", [Role = "BANK_REPORTER_ROLE", Implementation = "2.0"]),
				    BANK_HEALTH_Database = Source{[Name = "BANK_HEALTH", Kind = "Database"]}[Data],
				    MARTS_Schema = BANK_HEALTH_Database{[Name = "MARTS", Kind = "Schema"]}[Data],
				    Data = MARTS_Schema{[Name = "MART_BANK_SCORECARD", Kind = "Table"]}[Data],
				    Kept = Table.SelectColumns(Data, {"CERT", "REPORT_DATE", "ASSET_SIZE_TIER", "PEERS_IN_TIER", "TOTAL_ASSETS_K", "TOTAL_DEPOSITS_K", "NET_INCOME_QTR_K", "ROA_PCT", "NONCURRENT_LOANS_PCT", "TIER1_LEVERAGE_PCT", "EFFICIENCY_RATIO_PCT", "CRE_TO_EQUITY_PCT", "LOAN_GROWTH_YOY_PCT", "DEPOSIT_GROWTH_YOY_PCT", "COMPLAINT_DATA_COVERED", "COMPLAINTS", "COMPLAINTS_PER_1B_DEPOSITS", "COMPLAINTS_PER_1B_DEPOSITS_PEER_PCTILE"})
				in
				    Kept

	annotation PBI_ResultType = Table

