model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]



ref cultureInfo en-US

annotation PBI_QueryOrder = ["SnowflakeServer", "Bank", "Scorecard", "Early Warning", "Complaints"]

ref table Bank
ref table Scorecard
ref table 'Early Warning'
ref table Complaints
ref table Quarter
