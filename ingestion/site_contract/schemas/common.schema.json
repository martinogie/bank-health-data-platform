{
  "$id": "common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fields every Bank Health site data file carries",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "quarter", "dataAsOf"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixture": {"type": "boolean"},
    "generatedAt": {"type": "string", "minLength": 10},
    "quarter": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "dataAsOf": {
      "type": "object",
      "required": ["quarterLabel", "updated"],
      "properties": {
        "quarterLabel": {"type": "string", "pattern": "^\\d{4} Q[1-4]$"},
        "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  },
  "$defs": {
    "band": {"enum": ["H", "E", "W", "L", "D", "N", "F"]},
    "prob": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "driver": {"enum": ["credit", "earnings", null]}
  }
}
