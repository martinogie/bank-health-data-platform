# /etc/systemd/system/bank-health-secrets.service  (installed once by Martins; docs/runbooks/vault.md)
#
# At every boot, before Docker starts the containers: read the prod secrets from OCI Vault, as the
# VM itself (instance principal), into /run/bank-health (RAM; gone at power-off). Nothing secret is
# kept on disk. deploy.sh refreshes the same folder on each deploy.
[Unit]
Description=Bank Health: fetch secrets from OCI Vault into /run/bank-health (RAM only)
Wants=network-online.target
After=network-online.target
Before=docker.service
# With Restart= below: give up after 10 failed tries in 10 minutes (then see the runbook).
StartLimitBurst=10
StartLimitIntervalSec=600

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0077
# systemd creates /run/bank-health for the deploy user (mode 700) and keeps it after this exits.
RuntimeDirectory=bank-health
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/srv/bank-health/venv/bin/python /srv/bank-health/app/deploy/vault_secrets.py fetch
# The network or the Vault may not answer yet at boot: try again every 30 s.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
