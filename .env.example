# Copy this file to .env and fill in the values yourself. .env is git-ignored.
# Keep comments on their own lines: Docker Compose reads "KEY=   # note" as the
# value "# note" when nothing is written before the #.

# --- Databricks (Free Edition) ---
# Your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=
# Settings -> Developer -> Access tokens (you create and paste it)
DATABRICKS_TOKEN=
# Filled in after the job is created
DATABRICKS_JOB_ID=

# --- Snowflake ---
# Your account identifier, ORGNAME-ACCOUNTNAME (Snowsight -> account menu -> Account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_BANK_PIPELINE
SNOWFLAKE_ROLE=BANK_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=BANK_WH
SNOWFLAKE_DATABASE=BANK_HEALTH
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/keys/snowflake_rsa_key.p8
# Only if you encrypted the private key; otherwise leave empty
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Airflow (local Docker) ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
# Choose your own password for the Airflow UI
_AIRFLOW_WWW_USER_PASSWORD=
# The next two are filled by: python scripts/generate_airflow_secrets.py
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
